{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "extensions": {
    "serviceBus": {
      "autoCompleteMessages": false,
      "maxConcurrentSessions": 16,
      "maxAutoLockRenewalDuration": "00:10:00",
      "sessionIdleTimeout": "00:00:30"
    }
  }
}
